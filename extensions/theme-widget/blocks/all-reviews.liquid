{% comment %}
  "All reviews" app block — the full, paginated/searchable reviews list
  (apps.reviews.all.jsx) embedded directly on a themed page instead of only
  reachable as its own bare app-proxy page. Add this to the product page
  template (further down, below "Product reviews") for an inline "view all"
  section, or to a custom Page's template (Online Store > Pages > add a
  page, choose/duplicate a template that includes this block) for a
  dedicated, fully-themed "All reviews" page — see this block's schema
  `info` and the app's README for the exact steps. Same box-model settings
  pattern as product-reviews.liquid/write-review.liquid (see that file's
  header comment for the full reasoning behind the {% style %} block below).
{% endcomment %}
{% style %}
  #shopify-block-{{ block.id }} {
    display: block;
    width: 100%;
    max-width: none;
  }
{% endstyle %}
{%- liquid
  assign jm_align = block.settings.alignment
  assign jm_margin_x = "0"
  if jm_align == "left"
    assign jm_margin_x = "0 auto 0 0"
  elsif jm_align == "right"
    assign jm_margin_x = "0 0 0 auto"
  else
    assign jm_margin_x = "0 auto"
  endif

  assign jm_max_width_css = block.settings.max_width | append: "px"
  if block.settings.max_width >= 2000
    assign jm_max_width_css = "none"
  endif
-%}
{% comment %}
  data-product-id is empty when this block sits on a generic Page (no
  `product` in Liquid scope there) rather than the product template —
  jm-reviews-all.js falls back to reading ?productId=... from the URL in
  that case, so one Page with this block works for every product (e.g.
  Online Store > Pages > "Reviews", linked to as
  /pages/reviews?productId={{productId}} from the widget's {{moreUrl}} —
  see app.settings.jsx's "All reviews page" setting).
{% endcomment %}
<div
  data-jm-reviews-all
  data-product-id="{{ product.id }}"
  style="
    width: {{ block.settings.width }}%;
    max-width: {{ jm_max_width_css }};
    margin: {{ jm_margin_x }};
    margin-top: {{ block.settings.margin_top }}px;
    margin-bottom: {{ block.settings.margin_bottom }}px;
    padding: {{ block.settings.padding }}px;
    border-radius: {{ block.settings.border_radius }}px;
    {%- if block.settings.background_color != blank %}
    background-color: {{ block.settings.background_color }};
    {%- endif %}
    box-sizing: border-box;
  "
>
  <p class="jm-reviews__loading">Loading reviews…</p>
</div>

<script src="{{ 'jm-reviews-all.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "All reviews",
  "target": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "The full, paginated and searchable reviews list. Add this to the product page template for an in-page 'view all' section, OR add it to one standalone Page (Online Store > Pages > Add page) to get a single reusable reviews page for every product — link to it as /pages/your-page-handle?productId={{productId}} (that token is available anywhere in the widget's own template)."
    },
    {
      "type": "header",
      "content": "Size & spacing"
    },
    {
      "type": "range",
      "id": "width",
      "label": "Width",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 300,
      "max": 2000,
      "step": 20,
      "unit": "px",
      "default": 800,
      "info": "Drag all the way right for no cap (full available width)"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center",
      "info": "Only visible when width or max width leaves extra room"
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Top spacing",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#00000000"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Corner rounding",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
