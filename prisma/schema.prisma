// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// ---------------------------------------------------------------------------
// Tenant + Shopify data mirror
// ---------------------------------------------------------------------------

enum SyncStatus {
  PENDING
  RUNNING
  COMPLETE
  FAILED
}

model Shop {
  id                String     @id @default(cuid())
  domain            String     @unique
  email             String?
  planName          String?
  currencyCode      String?
  ianaTimezone      String?
  installedAt       DateTime   @default(now())
  uninstalledAt     DateTime?
  catalogSyncStatus SyncStatus @default(PENDING)
  catalogSyncedAt   DateTime?
  orderSyncStatus   SyncStatus @default(PENDING)
  orderSyncedAt     DateTime?
  syncError         String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  settings           ShopSettings?
  widgetTheme        WidgetTheme?
  reviewFormTheme    ReviewFormTheme?
  ratingSummaryTheme RatingSummaryTheme?
  emailLayouts       EmailLayout[]
  products           Product[]
  variants           Variant[]
  customers          Customer[]
  orders             Order[]
  orderLineItems     OrderLineItem[]
  reviewRequests     ReviewRequest[]
  reviews            Review[]
  scheduleRules      ScheduleRule[]
  emailTemplates     EmailTemplate[]
  reviewDiscounts    ReviewDiscount[]
}

// Single global row. The web process gets the live tunnel URL injected by
// `shopify app dev`; the worker process doesn't, so the web process writes
// it here on boot and the worker reads it from here instead of a static
// env var that goes stale every tunnel restart.
model AppConfig {
  key   String @id
  value String
}

// Per-shop preferences that aren't trigger scheduling (that's ScheduleRule).
model ShopSettings {
  id                       String   @id @default(cuid())
  shopId                   String   @unique
  shop                     Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  // When true, a submitted review is published immediately (skipping the
  // PENDING moderation queue) if its rating >= autoPublishMinRating.
  autoPublishEnabled       Boolean  @default(false)
  autoPublishMinRating     Int      @default(4)
  // Ordered day-offsets for the no-review-yet follow-up chain, e.g. [3, 7, 14]
  // means: 3 days after the request email, then 7 days after that reminder,
  // then 14 after that one. Each entry must be >=1 (no same-day reminders —
  // day 0 is the original request); capped to 3 entries to avoid spam. Empty
  // = reminders off.
  reminderDays             Int[]    @default([])
  // Thank-you discount for submitting a review — off by default. Vendor
  // controls whether it fires at all, the percentage off, and how many days
  // the code stays valid; see discounts/createReviewDiscount.server.ts.
  reviewDiscountEnabled    Boolean  @default(false)
  reviewDiscountPercentage Int      @default(10)
  reviewDiscountExpiryDays Int      @default(30)
  // Where the widget's "Show more"/{{moreUrl}} link points once a product
  // has more reviews than fit inline (see apps.reviews.jsx's
  // INLINE_REVIEW_LIMIT). Null = the built-in bare app-proxy page,
  // /apps/reviews/all?productId=... (no theme header/footer). Set this to a
  // real themed Shopify Page's path (e.g. "/pages/reviews", created from the
  // "All reviews" theme block — extensions/theme-widget/blocks/all-reviews.liquid)
  // to link there instead; apps.reviews.jsx appends "?productId=<id>" (or
  // "&productId=..." if the path already has a query string) automatically.
  allReviewsPageUrl        String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

// The storefront review widget's markup/styling, per shop. No row = use the
// hardcoded defaults in reviewWidget/defaults.server.ts. `html` holds
// <!--ITEM-->...<!--/ITEM--> and <!--EMPTY-->...<!--/EMPTY--> marker blocks
// that render.server.ts repeats/swaps per review; see that file for the
// full {{token}} list. `css` is injected as-is into a <style> tag.
model WidgetTheme {
  id          String   @id @default(cuid())
  shopId      String   @unique
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  html        String
  css         String
  // Optional structured alternative to hand-written CSS — a list of
  // {target, property, value} rows a non-coder can fill in from dropdowns
  // (see reviewWidget/styleBlocks.server.ts for the target/property
  // catalog). Compiled to CSS and appended after `css` at render time, so
  // these take precedence over the raw stylesheet.
  styleBlocks Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// The "write a review" page/fragment's markup+styling
// (routes/apps.reviews.write.jsx + the write-review theme block), per shop —
// same pattern as WidgetTheme but for that page instead of the read-only
// reviews list. No row = use the hardcoded defaults in
// reviewWidget/reviewFormTemplate.ts. `html` supports the
// {{productTitle}}/{{productTitleSuffix}}/{{productTitleHeadingSuffix}}
// tokens and an optional <!--IMAGE-->...<!--/IMAGE--> block (see that file
// for the full list); `css` is injected as-is, same as WidgetTheme.css.
// `styleBlocks` reuses the exact same {target, property, value} shape/
// compiler as WidgetTheme (reviewWidget/styleBlocks.server.ts) — targets are
// the "writeForm*" entries in reviewWidget/sections/writeForm.ts. Edited from
// its own dedicated builder (/app/review-form-editor) — never from
// app.widget-editor/app.widget-style, which only ever touch WidgetTheme (the
// read-only list widget).
model ReviewFormTheme {
  id          String   @id @default(cuid())
  shopId      String   @unique
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  html        String
  css         String
  styleBlocks Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// The storefront "star rating + review count" summary badge, per shop — a
// much lighter sibling of WidgetTheme/ReviewFormTheme: no free-form block
// canvas, just a handful of structured controls (colors, size, alignment,
// whether the count text shows at all) plus an optional raw HTML/CSS escape
// hatch, same "blocks" vs "html" mode split as EmailTemplate.mode. No row =
// the hardcoded defaults in reviewWidget/ratingSummaryTemplate.ts. In "html"
// mode, `html`/`css` are used as-is (tokens: {{averageStars}} {{averageValue}}
// {{count}} {{reviewWord}}); in "blocks" mode they're regenerated from the
// structured fields on every save so the two modes never drift apart, and the
// storefront renderer always just uses whatever's in `html`/`css` regardless
// of mode.
model RatingSummaryTheme {
  id             String   @id @default(cuid())
  shopId         String   @unique
  shop           Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  mode           String   @default("blocks")
  starColor      String   @default("#f5a623")
  emptyStarColor String   @default("#d9d9d9")
  textColor      String   @default("#6b6b6b")
  fontSize       Int      @default(14)
  align          String   @default("left")
  showCount      Boolean  @default(true)
  countText      String   @default("({{count}} {{reviewWord}})")
  html           String
  css            String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Email layouts (absolute-position visual builder)
// ---------------------------------------------------------------------------

// One row per trigger type, per shop — the visual-builder counterpart to
// EmailTemplate. A vendor designs with free-position elements (text/image/
// button blocks with x/y/width/height/style, like the widget editor's block
// canvas) and this stores that design as `elements` (Json array of
// EmailElement — see email/emailLayoutCompiler.ts); `mode: "html"` switches
// to a raw HTML/CSS override (`rawHtml`) instead, same split as
// RatingSummaryTheme.mode/EmailTemplate.mode. Actually sending an email never
// reads this table directly — resolveTemplate (templates.server.ts) checks
// here first (compiling `elements`/`rawHtml` to table-based, email-client-safe
// HTML via emailLayoutCompiler.ts) and falls back to EmailTemplate, then the
// hardcoded default, exactly like the existing fallback chain.
model EmailLayout {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  triggerType String
  mode        String   @default("canvas")
  subject     String
  elements    Json
  rawHtml     String   @default("")
  canvasWidth Int      @default(480)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([shopId, triggerType])
  @@index([shopId])
}

// Editable wording per trigger type. subject/bodyHtml support {{tokens}}
// (customerName, productTitle, shopName, reviewUrl, reminderNumber) filled
// in at send time. No row = use the hardcoded default in templates.server.ts.
// mode "normal" = edited with the constrained rich-text editor; "html" =
// vendor writes/pastes raw HTML directly, full flexibility, no toolbar
// limits (and no safety net — it's sent as-is).
model EmailTemplate {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  triggerType String
  mode        String   @default("normal")
  subject     String
  bodyHtml    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([shopId, triggerType])
  @@index([shopId])
}

// One row per Shopify event type ("orders/paid", "orders/fulfilled", and any
// future webhook topic a vendor wants a request tied to). delayDays=0 means
// "fire as soon as the event hits" — useful for testing and for a same-day
// touchpoint. Whenever a webhook of `triggerType` fires, the handler checks
// for an enabled rule here and schedules the request from it — new trigger
// types just need a new row + a webhook subscription, no code branching.
model ScheduleRule {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  triggerType String
  delayDays   Int      @default(0)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([shopId, triggerType])
  @@index([shopId])
}

model Product {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopifyId   String
  title       String
  handle      String?
  status      String?
  vendor      String?
  productType String?
  imageUrl    String?
  syncedAt    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants       Variant[]
  lineItems      OrderLineItem[]
  reviewRequests ReviewRequest[]
  reviews        Review[]

  @@unique([shopId, shopifyId])
  @@index([shopId])
}

model Variant {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  shopifyId String
  title     String?
  sku       String?
  price     Decimal? @db.Decimal(10, 2)
  syncedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems OrderLineItem[]

  @@unique([shopId, shopifyId])
  @@index([shopId])
  @@index([productId])
}

model Customer {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopifyId String
  email     String?
  firstName String?
  lastName  String?
  syncedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders         Order[]
  reviewRequests ReviewRequest[]
  reviews        Review[]

  @@unique([shopId, shopifyId])
  @@index([shopId])
  @@index([shopId, email])
}

model Order {
  id                String    @id @default(cuid())
  shopId            String
  shop              Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopifyId         String
  name              String?
  customerId        String?
  customer          Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  email             String?
  currencyCode      String?
  totalPrice        Decimal?  @db.Decimal(10, 2)
  financialStatus   String?
  fulfillmentStatus String?
  processedAt       DateTime?
  cancelledAt       DateTime?
  syncedAt          DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  lineItems      OrderLineItem[]
  reviewRequests ReviewRequest[]

  @@unique([shopId, shopifyId])
  @@index([shopId])
  @@index([shopId, processedAt])
}

model OrderLineItem {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shopifyId String?
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId String?
  variant   Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  title     String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, shopifyId])
  @@index([shopId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Review requests (proof-of-purchase tokens)
// ---------------------------------------------------------------------------

enum ReviewRequestStatus {
  PENDING
  SENT
  REMINDED_1
  REMINDED_2
  REMINDED_3
  COMPLETED
  CANCELLED
}

model ReviewRequest {
  id                   String              @id @default(cuid())
  shopId               String
  shop                 Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orderId              String
  order                Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId           String?
  customer             Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  productId            String?
  product              Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  token                String              @unique
  channel              String              @default("email")
  triggerType          String
  status               ReviewRequestStatus @default(PENDING)
  scheduledAt          DateTime?
  sentAt               DateTime?
  firstReminderAt      DateTime?
  secondReminderAt     DateTime?
  thirdReminderAt      DateTime?
  // The currently-scheduled reminder job's BullMQ id, if any (see
  // queue.server.ts). On review submission we best-effort cancel this job;
  // the reminder worker itself re-checks `review`/`status` before sending
  // as a fallback in case that cancellation didn't land in time.
  pendingReminderJobId String?
  completedAt          DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  review               Review?

  @@unique([orderId, productId, channel, triggerType])
  @@index([shopId])
  @@index([token])
}

// ---------------------------------------------------------------------------
// Reviews (submitted via the hosted /r/:token form)
// ---------------------------------------------------------------------------

enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
  SPAM
  REJECTED
}

model Review {
  id              String         @id @default(cuid())
  shopId          String
  shop            Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productId       String
  product         Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Null for a review submitted directly from the storefront's inline
  // {{rateWidget}} control (apps.reviews.jsx action) — those aren't tied to
  // an email/token flow at all, unlike the /r/:token hosted-form path.
  reviewRequestId String?        @unique
  reviewRequest   ReviewRequest? @relation(fields: [reviewRequestId], references: [id], onDelete: Cascade)
  customerId      String?
  customer        Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  rating          Int
  title           String?
  body            String?
  authorName      String?
  verifiedBuyer   Boolean        @default(true)
  status          ReviewStatus   @default(PENDING)
  hiddenReason    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  discount ReviewDiscount?

  @@index([shopId])
  @@index([productId])
  @@index([shopId, status])
}

enum ReviewDiscountStatus {
  PENDING
  CREATED
  FAILED
}

// A one-time thank-you discount generated after a review is submitted (see
// discounts/createReviewDiscount.server.ts). One row per review — the
// `reviewId` unique constraint is the idempotency guard against creating a
// second code for the same review. `status: FAILED` is the "flag for
// retry/manual follow-up" signal: Shopify's discountCodeBasicCreate call
// didn't succeed, `failureReason` has why, and the review's thank-you email
// still went out, just without a code.
model ReviewDiscount {
  id                String               @id @default(cuid())
  shopId            String
  shop              Shop                 @relation(fields: [shopId], references: [id], onDelete: Cascade)
  reviewId          String               @unique
  review            Review               @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  customerEmail     String
  code              String               @unique
  shopifyDiscountId String?
  percentageOff     Int
  status            ReviewDiscountStatus @default(PENDING)
  failureReason     String?
  expiresAt         DateTime
  redeemedAt        DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([shopId])
  @@index([shopId, status])
}

// ---------------------------------------------------------------------------
// Webhook idempotency ledger
// ---------------------------------------------------------------------------

enum WebhookEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

model WebhookEvent {
  id          String             @id @default(cuid())
  shopDomain  String
  topic       String
  webhookId   String             @unique
  payload     Json?
  status      WebhookEventStatus @default(RECEIVED)
  error       String?
  receivedAt  DateTime           @default(now())
  processedAt DateTime?

  @@index([shopDomain])
  @@index([shopDomain, topic])
}
